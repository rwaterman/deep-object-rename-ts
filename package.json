{
  "name": "deep-object-rename",
  "version": "2.0.0",
  "description": "A Javascript library for deep object renaming by key or value, written in TypeScript",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    }
  },
  "types": "lib/index.d.mts",
  "files": [
    "lib/**/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.mts\" \"*.{json,md,mjs}\"",
    "lint": "eslint src",
    "postversion": "git push && git push --tags",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "test": "node --test \"src/**/*.test.mts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rwaterman/deep-object-rename.git"
  },
  "keywords": [
    "TypeScript",
    "Object",
    "Deep Rename"
  ],
  "author": "Rick Waterman",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
