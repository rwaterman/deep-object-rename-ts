{
  "name": "@rwaterman/deep-object-rename",
  "version": "2.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "A Javascript library for deep object renaming by key or value, written in TypeScript",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    }
  },
  "types": "lib/index.d.mts",
  "files": [
    "lib/**/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.mts\" \"*.{json,md,mjs}\"",
    "lint": "oxlint --type-aware --deny-warnings src",
    "postversion": "git push && git push --tags",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "preversion": "npm run lint",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rwaterman/deep-object-rename-ts.git"
  },
  "keywords": [
    "TypeScript",
    "Object",
    "Deep Rename"
  ],
  "author": "Rick Waterman",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
